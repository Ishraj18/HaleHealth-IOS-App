// ───────────────────────────────────────────────────────────────────────────
// Secrets.xcconfig.example — TEMPLATE ONLY.
//
// 1. Copy this file:   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
// 2. Fill in real values below.
// 3. Never commit Config/Secrets.xcconfig — it is git-ignored.
//
// ⚠️  xcconfig gotcha: a literal "//" starts a comment, so a raw URL such as
//     https://example.com would be silently TRUNCATED to "https:".
//     Use the $() escape (an empty variable reference) to emit a literal "//",
//     exactly as shown for SUPABASE_URL below.
// ───────────────────────────────────────────────────────────────────────────

// Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co

// Supabase anon/public API key (JWT).
SUPABASE_ANON_KEY = your_supabase_anon_key_here

// AQICN (waqi.info) API token — https://aqicn.org/data-platform/token/
AQICN_TOKEN = your_aqicn_token_here
